            e.printStackTrace();
        }
    }

    public void linear(int n) {
    	for (int i = 0;i<n; i++) {
    		doNothing();
    	}
    }

    public void quadratic(int n) {
    	for (int i = 0;i<n; i++) {
    		for (int j = 0;j<n; j++) {
        		doNothing();
        	}
    	}
    }

    public void cubic(int n) {
    	for (int i = 0;i<n; i++) {
    		for (int j = 0;j<n; j++) {
        		for (int k = 0;k<n; k++) {
