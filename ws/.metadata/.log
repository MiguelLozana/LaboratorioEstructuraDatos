package algorithmics;

public class Algorithms {
	private static final long SLEEP_TIME = 1;


	
	
	
	public static int factorial(int n){
		if (n==0) {
			return 1;
		}
		return factorial(n-1)*n;
	}
	
	
	
	public static boolean esImpoar(int n) {
		if( n == 1 ) {
			return true;
		}
		else if( n == 2 ) {
			return false;
		}
		else {
			return esImpoar(n-2);
		}
		
	}
	
	
	
	public static int fibonnacci(int index) {
		if( index == 0 || index == 1 ) {
			return 1;
		}
		return fibonnacci(index-1) +  fibonnacci(index-2);
	}

	
	public static int division(int dividendo , int divisor) {
		if (dividendo < divisor ) {
			return 0;
		}
		return 1 + division(dividendo - divisor,divisor );

	}
	
	
	public static int resto(int dividendo , int divisor) {
		if (dividendo < divisor){
			return divisor;
		}
		return resto(dividendo - divisor , divisor);
	}
	
	public static int fibonacci_iteractive(int index) {
		int lower = 0;
		int higher = 1;
		if (index == 0) {
			return 0;
		}
		for(int i = 0; i<  index; i++) {
			int newer = lower + higher;
			lower = higher;
			higher = newer;
		}
		return higher;
		
		
	}
