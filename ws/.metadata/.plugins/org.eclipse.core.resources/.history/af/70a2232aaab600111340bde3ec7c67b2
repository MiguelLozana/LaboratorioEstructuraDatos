package algorithmics;
import java.io.BufferedWriter;
import java.io.FileWriter;
import java.io.IOException;
import java.io.PrintWriter;
import java.lang.reflect.InvocationTargetException;
import java.lang.reflect.Method;

public class Cronometro {
    public long[] medir(String nombreMetodo, int startN, int endN) throws NoSuchMethodException, InvocationTargetException, IllegalAccessException {
        long[] medir = new long[endN-startN+1];

        Algorithms alg = new Algorithms();
        Method m = alg.getClass().getMethod(nombreMetodo, int.class);

        long tInicial, tFinal;
        for (int i = 0; i < medir.length; i++) {
            int n = startN+i;
            tInicial = System.currentTimeMillis();
            m.invoke(alg, n);
            tFinal = System.currentTimeMillis();
            medir[i] = tFinal-tInicial;
        }

        return medir;
    }

    public void experimentar(String filename, String nombreMetodo, int startN, int endN) {
        try {
            long[] datos = medir(nombreMetodo, startN, endN);
            try (PrintWriter writer = new PrintWriter(new FileWriter(filename))) {
                for (int i = 0; i < datos.length; i++)
                    writer.printf("%d;%d\n", startN+i, datos[i]);
            } catch (IOException e) {
                System.err.println("Error al escribir los datos del archivo");
                throw new RuntimeException(e);
            }
        } catch (NoSuchMethodException | InvocationTargetException | IllegalAccessException e) {
            System.err.println("Error al ejecutar el algoritmo para tomar mediciones");
            throw new RuntimeException(e);
        }
    }

    public static void main(String[] args) {
        Cronometro cronometro = new Cronometro();
//        cronometro.experimentar("linear.csv", "linear", 1, 20);
//        cronometro.experimentar("quadratic.csv", "quadratic", 1, 20);
//        cronometro.experimentar("cubic.csv", "cubic", 1, 20);
        cronometro.experimentar("pow2.csv", "pow2", 1, 200);
        cronometro.experimentar("pow2Rec2.csv", "pow2Rec2", 1, 200);
        cronometro.experimentar("pow2Rec3b.csv", "pow2Rec3b", 1, 200);
        cronometro.experimentar("pow2Rec2b.csv", "pow2Rec2b", 1, 200);
        
    }
}
