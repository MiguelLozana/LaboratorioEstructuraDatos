    //n
    public long pow2(int n) {
    	int res =1;
    	for (int i = 0 ; i< n ;i++) {
    		res *=2;
    		doNothing();
    	}
    	return res;
    }
    
    // n+1
    public long pow2Rec(int n) {
    	doNothing();
    	if (n== 0)
    		return 1;
    	
    	return  2* pow2Rec(n-1);
    }
