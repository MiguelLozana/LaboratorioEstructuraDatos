    public static void doNothing() {
        try {
            Thread.sleep(SLEEP_TIME);
        } catch (InterruptedException e) {
            e.printStackTrace();
        }
    }

    public void linear(int n) {
    	for (int i = 0;i<n; i++) {
    		doNothing();
    	}
    }

    public void quadratic(int n) {
    	for (int i = 0;i<n; i++) {
    		for (int j = 0;j<n; j++) {
        		doNothing();
        	}
    	}
    }

    public void cubic(int n) {
    	for (int i = 0;i<n; i++) {
    		for (int j = 0;j<n; j++) {
        		for (int k = 0;k<n; k++) {
            		doNothing();
            	}
        	}
    	}
    }
    // O(n)
    public long pow2Rec2(int n) {
    	doNothing();
    	if (n == 1) {
    		return 2;
    	}
    	return pow2Rec2(n-1);
    }

    public long pow2Rec2b(int n) {
    	doNothing();
    	if (n==0){
    		return 1;
    	}
    	if (n%2 == 0){
    		return pow2Rec2b(n/2) * pow2Rec2b(n/2);
    	}
    	else {
    		n = n-1;
    		return pow2Rec2b(n/2) * pow2Rec2b(n/2) * 2;
    	}
    }

